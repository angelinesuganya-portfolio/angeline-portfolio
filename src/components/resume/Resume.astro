---
import { education, experience, skills } from '../../data/resume';
import type { TimelineSection } from '../../data/types';

const timelines: TimelineSection[] = [education, experience];
---

<article class="resume" data-page="resume">

  <header>
    <h2 class="h2 article-title">Resume</h2>
  </header>

  {timelines.map((timeline) => (
    <section class="timeline">

      <div class="title-wrapper">
        <div class="icon-box">
          <ion-icon name={timeline.icon}></ion-icon>
        </div>

        <h3 class="h3">{timeline.heading}</h3>
      </div>

      <ol class="timeline-list">
        {timeline.entries.map((entry) => (
          <li class="timeline-item">

            <h4 class="h4 timeline-item-title">{entry.title}</h4>

            <span>{entry.period}</span>

            <p class="timeline-text">
              {entry.text}
            </p>

          </li>
        ))}
      </ol>

    </section>
  ))}

  <section class="skill">

    <h3 class="h3 skills-title">My skills</h3>

    <ul class="skills-list content-card">
      {skills.map((skill) => (
        <li class="skills-item">

          <div class="title-wrapper">
            <h5 class="h5">{skill.name}</h5>
            <data value={skill.value}>{skill.value}%</data>
          </div>

          <div class="skill-progress-bg">
            <div class="skill-progress-fill" style={`width: ${skill.value}%;`}></div>
          </div>

        </li>
      ))}
    </ul>

  </section>

</article>
